{
  "name": "nirmala-foundation-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready REST API for Nirmala Foundation Nepal",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
