NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:8080,http://localhost:5173,http://localhost:3000

# MongoDB Atlas connection string (include a database name in the path)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nirmala?retryWrites=true&w=majority

# Auth — use a long random string for JWT_SECRET (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

SEED_ADMIN_NAME=Nirmala Admin
SEED_ADMIN_EMAIL=admin@nirmala.org
SEED_ADMIN_PASSWORD=change-me

LOG_LEVEL=info

# Email (optional) — leave SMTP_HOST empty to log instead of send
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nirmala Foundation <no-reply@nirmalafoundation.org.np>
ADMIN_NOTIFY_EMAIL=

# ==================================================================
# PAYMENTS
# ==================================================================
# Currency all donations are reported/aggregated in.
PAYMENT_BASE_CURRENCY=NPR
# Currencies the donate form may accept.
PAYMENT_SUPPORTED_CURRENCIES=NPR,USD,EUR,GBP,AUD,CAD,INR,JPY,SGD,AED
# Units of PAYMENT_BASE_CURRENCY per 1 unit of each currency.
# DUMMY RATES — replace with your bank's daily card rate or an FX feed.
PAYMENT_FX_RATES=USD:141.5,EUR:153.2,GBP:178.4,AUD:92.1,CAD:101.6,INR:1.6,JPY:0.93,SGD:104.8,AED:38.5

PAYMENT_DEFAULT_GATEWAY=globalime
# Frontend pages the donor is bounced back to after paying.
PAYMENT_RETURN_URL=http://localhost:8080/donate/thank-you
PAYMENT_CANCEL_URL=http://localhost:8080/donate?cancelled=1
# Public URL of THIS api — used to build the callback/webhook URLs sent to the
# bank. MUST be publicly reachable in production (e.g. https://api.yourdomain.org).
PUBLIC_API_URL=http://localhost:5000
# Minutes an unfinished payment stays claimable before it is expired.
PAYMENT_SESSION_TTL_MINUTES=45
PAYMENT_RATE_LIMIT_MAX=20

# ------------------------------------------------------------------
# Global IME Bank payment gateway
#
# ALL VALUES BELOW ARE DUMMY PLACEHOLDERS. Replace them with the real
# values from your Global IME merchant onboarding pack.
#
# GLOBALIME_MODE:
#   mock    → no network call; a local simulated checkout page runs the
#             full donate → pay → verify → receipt flow (default)
#   sandbox → the bank's UAT host, with test credentials
#   live    → production
# ------------------------------------------------------------------
GLOBALIME_ENABLED=true
GLOBALIME_MODE=mock
GLOBALIME_BASE_URL=https://uat-paymentgateway.globalimebank.com.np
GLOBALIME_MERCHANT_ID=NF-DUMMY-MERCHANT-001
GLOBALIME_MERCHANT_NAME=Nirmala Foundation Nepal
GLOBALIME_ACQUIRER_ID=GIBLNPKA
GLOBALIME_TERMINAL_ID=NFTERM01
GLOBALIME_API_KEY=dummy_api_key_replace_me
GLOBALIME_SECRET_KEY=dummy_secret_key_replace_me
GLOBALIME_WEBHOOK_SECRET=dummy_webhook_secret_replace_me
# Endpoint paths — banks move these between UAT and production.
GLOBALIME_CHECKOUT_PATH=/api/v1/payment/initiate
GLOBALIME_VERIFY_PATH=/api/v1/payment/verify
GLOBALIME_STATUS_PATH=/api/v1/payment/status
GLOBALIME_REFUND_PATH=/api/v1/payment/refund
GLOBALIME_CURRENCIES=NPR,USD,EUR,GBP,AUD,CAD,INR,JPY,SGD,AED
GLOBALIME_TIMEOUT_MS=20000

# ------------------------------------------------------------------
# Manual / offline bank transfer — shown to donors who pick "bank transfer".
# DUMMY ACCOUNT DETAILS — replace with the foundation's real account.
# ------------------------------------------------------------------
MANUAL_PAYMENT_ENABLED=true
MANUAL_BANK_NAME=Global IME Bank Ltd.
MANUAL_ACCOUNT_NAME=Nirmala Foundation Nepal
MANUAL_ACCOUNT_NUMBER=0000000000000000
MANUAL_BANK_BRANCH=New Baneshwor, Kathmandu
MANUAL_BANK_SWIFT=GLBBNPKA
MANUAL_PAYMENT_INSTRUCTIONS=Transfer to the account above and email your receipt to info@nirmalafoundation.org.np quoting your reference number.

# Cards issued OUTSIDE Nepal. Set false if Global IME has enabled only
# domestic acquiring — the donate form then stops offering overseas cards.
GLOBALIME_INTERNATIONAL=true
# Card networks your acquirer settles — rendered as logos on the donate form.
GLOBALIME_CARD_BRANDS=visa,mastercard,amex,unionpay
# Instruments offered on the bank's hosted page.
GLOBALIME_INSTRUMENTS=card,mobile-banking,internet-banking,wallet

# Cloudinary — admin image uploads. Copy "API environment variable" from the
# Cloudinary dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=nirmala
